#!/usr/bin/env bash

main() {
  local script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")" )"
  local cfg_home="$(realpath "${script_dir}/../../..")"
  cd "$cfg_home"

  if [ "$#" = "0" ]
  then
    local commands=(wait build) 
  else
    local commands=("$@")
  fi

  for current_command in "${commands[@]}"
  do
    "${current_command}-command" || exit 1
  done
}

edit-command() {
  "$EDITOR" .
}

lazygit-command() {
  command lazygit
}

build-command() {
  if [ -z "${CFG_NAME:-}" ]
  then
    read -p "Configuration name: " CFG_NAME
  fi

  echo "Building configuration for $CFG_NAME"
  nix run "$PWD#rebuild" -- build --flake "$PWD#$CFG_NAME"
}

switch-command() {
  git_author

  if [ -z "${CFG_NAME:-}" ]
  then
    read -p "Configuration name: " CFG_NAME
  fi

  echo "Applying configuration for $CFG_NAME"
  sudo -i nix run "$PWD#rebuild" -- switch --flake "$PWD#$CFG_NAME"
}

wait-command() {
  perform-wait() {
    echo
    read -p "Press any key to close." -n 1
  }
  trap perform-wait EXIT
}

if ! command -v git &>/dev/null
then
  alias git="nix run $PWD#git --"
fi

git_author() {
  local git_config_author_email_command=(
    git config --file ~/.config/git/config.local user.email
  )

  if ! "${git_config_author_email_command[@]}" > /dev/null
  then
    echo "⚠️ No git author configured yet."
    read -p "Enter git author email addres (leave empty to skip): " email

    if [ -n "$email" ]
    then
      "${git_config_author_email_command[@]}" "$email"
    fi
  fi
}

if ! command -v stow &>/dev/null
then
  alias stow="nix run $PWD#stow --"
fi

stow-command() {
  stow --restow .
}

apply-command() {
  switch-command && stow-command
}

main "$@"
