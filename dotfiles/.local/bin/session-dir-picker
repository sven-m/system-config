#!/usr/bin/env bash

menu() {
  tmux rename-window "$(basename $0)"
  FZF_DEFAULT_COMMAND="fd --hidden '^\.git$' --exec session-dir-picker fzf-line \; $HOME/src"\
    fzf \
    --ansi \
    --delimiter='\t' \
    --bind 'enter:become(session-dir-picker create-session {1})' \
    "$@"
}

fzf-line() {
  teal=$'\033[38;2;148;226;213m'
  yellow=$'\033[38;2;249;226;175m'
  reset=$'\033[0m'

  dir=$(dirname "$1")
  branch=$(git -C "$dir" symbolic-ref-or-commit)
  session=$(tmux list-sessions -F "#{session_name}" -f "#{==:#{session_path},$dir}" 2>/dev/null)

  printf "%s\t%s%s%s\t%s%s%s\n" "$dir" "$teal" "$branch" "$reset" "$yellow" "$session" "$reset"
}

create-session() {
  tmux rename-session "$(basename $1)"
  tmux attach-session -c "$1"
  cd "$1"
  tmux new-window lazygit
}


usage() {
  echo "usage: $(basename $0) [ menu [fzf-args] | fzf-line <dir> | create-session <dir> ]" >&2
  exit 1
}

cmd="${1:-menu}"
shift

case "$cmd" in
  fzf-line|create-session|menu) "$cmd" "$@" ;;
  *) usage ;;
esac
