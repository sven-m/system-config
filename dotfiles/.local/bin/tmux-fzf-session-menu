#!/usr/bin/env bash

fd_cmd="fd --hidden '^\.git$' --exec project-line-for-fzf \; $HOME/src"
new_session_cmd='tmux command-prompt -p "Session: " "new-session -Ad -s %1; switch-client -t %1"'

selection=$(
  FZF_DEFAULT_COMMAND="$fd_cmd" \
    fzf \
    --ansi \
    --accept-nth=1 \
    --delimiter='\t' \
    --bind 'enter:become(tmux command-prompt -p "Session name for {1}: " "new-session -Ad -s %1 -c {1}; switch-client -t %1")' \
    --bind "tab:up" \
    --bind "shift-tab:down" \
    "$@"
)
