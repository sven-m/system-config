#!/usr/bin/env bash
# tmux-save: scrape the live tmux server and write a .tmux script (plain
# tmux commands, meant to be `tmux source-file`'d) to
# $HOME/.local/state/tmux that recreates every session. Idempotent per
# session via a brace-grouped `if-shell`: a session that already exists is
# left completely untouched on re-source.
#
# Each generated line is built by tmux's own -F/-f, not by bash: a single
# `list-panes -f/-F` call IS the split-window lines for a window's panes
# 1..N (one call, one line per matching pane, no bash loop over panes at
# all). $session_name/$window_index are only needed to target each `-t` on
# the tmux commands run here (list-panes, display-message) -- inside the
# generated text itself, pane-level formats can already see their
# enclosing window/session, so it's #{session_name}/#{window_index} there,
# not bash variables. Bash still loops over sessions and windows
# themselves, since their *count* varies and nothing in tmux's command
# language can do that.
# The first pane in a window is whichever has #{pane-base-index} (usually
# 0 or 1, whatever pane-base-index is set to), not a hardcoded 0.
#
# #{window_layout} is single-quoted, not double-quoted: on tmux 3.8+ it's a
# JSON-subset string containing literal double quotes, which would
# otherwise terminate the argument early when this file is re-sourced.
#
# Only #{pane_start_command} is captured per pane (empty = plain shell).
# It's emitted UNQUOTED on purpose: tmux's own config-file parser then
# word-splits it into separate arguments, matching how it was originally
# launched (`nvim --clean file`, not `"nvim --clean file"`) -- quoting it
# would make tmux treat it as one opaque shell string instead.
set -euo pipefail

# `for x in $(cmd)` splits cmd's output on $IFS and then glob-expands each
# resulting word. IFS=$'\n' limits splitting to newlines (so a session or
# window name containing a space stays one word); `set -f` turns off the
# glob-expansion step (so a session literally named e.g. "test*" isn't
# expanded against files in the current directory).
IFS=$'\n'
set -f

mkdir -p "$HOME/.local/state/tmux"
exec > "$HOME/.local/state/tmux/restore-sessions.tmux"

tmux list-sessions >/dev/null 2>&1 || { echo "# no tmux server running"; exit 0; }

for session_name in $(tmux list-sessions -F '#{session_name}')
do
  echo "if-shell \"! tmux has-session -t $session_name 2>/dev/null\" {"
  echo "  new-session -d -s \"$session_name\""

  for window_index in $(tmux list-windows -t "$session_name" -F '#{window_index}')
  do
    target_window="$session_name:$window_index"

    tmux list-panes -t "$target_window" -f '#{==:#{pane_index},#{pane-base-index}}' \
      -F "  new-window -t \"#{session_name}:#{window_index}\" -k -n \"#{window_name}\" -c \"#{pane_current_path}\" #{pane_start_command}"

    tmux list-panes -t "$target_window" -f '#{!=:#{pane_index},#{pane-base-index}}' \
      -F "  split-window -t \"#{session_name}:#{window_index}\" -c \"#{pane_current_path}\" #{pane_start_command}"

    tmux display-message -p -t "$target_window" \
      "  select-layout -t \"#{session_name}:#{window_index}\" '#{window_layout}'"
  done

  tmux display-message -p -t "$session_name" "  select-window -t \"#{session_name}:#{window_index}\""
  echo "}"
  echo
done
